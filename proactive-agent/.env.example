# Copy this file to .env and fill it in; docker compose reads it. Without a .env file the service runs
# in demo mode with the example secrets below, which everybody who has read the documentation knows.

# demo: a script plays the agent; no key, no model calls.
# live: Claude Managed Agents, with an Anthropic API key that has access to them.
AGENT_CMA_MODE=demo
ANTHROPIC_API_KEY=

# Secrets of your own, at least 32 characters each. Make each with: openssl rand -hex 32
# The administration key opens /v1/admin; the token secret signs user tokens; the Inbox secret is
# shared by the two services.
AGENT_ADMIN_KEYS_0=change-me-admin-key-0123456789abcdef
AGENT_TOKENS_SECRETS_0=change-me-token-secret-0123456789abcdef
AGENT_INBOX_SECRET=change-me-inbox-secret-0123456789abcdef

# Database passwords. They are set when the database is first created; changing them here later
# does not change them in the database.
POSTGRES_PASSWORD=postgres
INBOX_DB_PASSWORD=inbox
AGENT_DB_PASSWORD=agent

# Origins of web pages that may call the API from the browser with a user token, comma-separated,
# for example https://app.example.com,http://localhost:3000. Empty: none.
AGENT_CORS_ALLOWEDORIGINS=

# Where the API listens. 127.0.0.1:8090 is this machine only; 0.0.0.0:8090 opens it to the network,
# which should then reach it through https (a reverse proxy in front).
AGENT_PUBLISH=127.0.0.1:8090

# Only to try webhooks on one machine, never in production: let the service deliver to private
# addresses over plain http, for example to http://host.docker.internal:9999/.
AGENT_WEBHOOKS_ALLOWPRIVATENETWORKS=false
AGENT_WEBHOOKS_ALLOWPLAINHTTP=false
