<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.3</version>
    <relativePath/>
  </parent>

  <groupId>dev.agentflow</groupId>
  <artifactId>proactive-agent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>proactive-agent</name>
  <description>Proactive agent infrastructure: the Event Inbox, and the agent service that opens a proactive agent to applications.</description>

  <modules>
    <module>inbox-api</module>
    <module>inbox-client</module>
    <module>openapi-testkit</module>
    <module>inbox-server</module>
    <module>agent-cma</module>
    <module>agent-api</module>
    <module>agent-server</module>
  </modules>

  <properties>
    <java.version>21</java.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    <swagger-request-validator.version>2.46.1</swagger-request-validator.version>
    <anthropic-java.version>3.12.0</anthropic-java.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>inbox-api</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>inbox-client</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>openapi-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>inbox-server</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>inbox-server</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>agent-cma</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.agentflow</groupId>
        <artifactId>agent-api</artifactId>
        <version>${project.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
